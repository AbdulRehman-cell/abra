# ------------------------------------------------------------------
# This is a static HTML/CSS/JS site. No server-side runtime env vars
# are strictly required. Variables below are optional/for parity
# with docker-compose and future extensibility.
# ------------------------------------------------------------------

# Logical environment label (informational only, not read by nginx)
SITE_ENV=production

# Port the container listens on internally (must match Dockerfile EXPOSE
# and nginx `listen` directive if changed). Render sets $PORT automatically
# for most runtimes, but Docker web services use the port you expose/health-check.
PORT=8080