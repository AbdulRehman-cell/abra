# ---------------------------------------------------------------------------
# .env.example — this static site currently requires NO runtime env vars.
# Variables below are optional/reserved for future use or CI/CD only.
# Copy to .env if running locally with docker-compose and adjust as needed.
# ---------------------------------------------------------------------------

# Timezone used inside the nginx container (optional, defaults to UTC)
TZ=UTC

# ---------------------------------------------------------------------------
# CI/CD only — set these as GitHub Actions repository secrets, NOT in .env
# ---------------------------------------------------------------------------
# RENDER_DEPLOY_HOOK_URL=  # From Render Dashboard > Service > Settings > Deploy Hook