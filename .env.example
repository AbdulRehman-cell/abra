# -----------------------------------------------------------------------------
# .env.example — This is a plain static HTML/CSS/JS site.
# There are NO required runtime environment variables for the app itself.
# The variables below are OPTIONAL and only relevant for CI/CD (GitHub Actions
# deploying to Render) or local tooling. Copy this file to `.env` if you need
# any of them locally; do NOT commit a real `.env` file.
# -----------------------------------------------------------------------------

# --- Render deployment (used only in CI, not by the app itself) ------------
# API key generated from Render Dashboard > Account Settings > API Keys
# Required as a GitHub Actions secret: RENDER_API_KEY
RENDER_API_KEY=

# The Render Service ID for this static site (found in the Render dashboard
# URL or via `render services list`).
# Required as a GitHub Actions secret: RENDER_SERVICE_ID
RENDER_SERVICE_ID=

# --- Optional: local port override for docker-compose -----------------------
# Port exposed on your host machine when running `docker compose up`
HOST_PORT=8080